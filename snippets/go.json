{
  "Add test function": {
    "prefix": "test",
    "body": [
      "func Test${1:Name}(t *testing.T) {",
      "\t${2:body}",
      "}"
    ]
  },
  "Err handling": {
    "prefix": "ife",
    "body": [
      "if err != nil {",
      "\treturn err",
      "}"
    ]
  },
  "Err handling nil err": {
    "prefix": "iferrnil",
    "body": [
      "if err != nil {",
      "\treturn nil, err",
      "}"
    ]
  }
}
